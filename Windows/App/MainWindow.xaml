<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="NetNewsWire.Windows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:NetNewsWire.Windows.ViewModels"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Title="NetNewsWire">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar: the app name is the drag region; the search box stays interactive. -->
        <Grid x:Name="AppTitleBar" ColumnSpacing="12" Padding="16,0,140,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="NetNewsWire" VerticalAlignment="Center" Style="{StaticResource CaptionTextBlockStyle}" />
            <AutoSuggestBox x:Name="SearchBox" Grid.Column="2" Width="360" VerticalAlignment="Center"
                            x:Uid="SearchBox" PlaceholderText="Search articles" QueryIcon="Find"
                            QuerySubmitted="SearchBox_QuerySubmitted"
                            AutomationProperties.Name="Search articles" />
        </Grid>

        <CommandBar x:Name="Toolbar" Grid.Row="1" DefaultLabelPosition="Right" HorizontalAlignment="Left" Background="Transparent">
            <AppBarButton x:Name="RefreshButton" Icon="Refresh" x:Uid="Toolbar_Refresh" Label="Refresh" Click="Refresh_Click" ToolTipService.ToolTip="Refresh (Ctrl+R)" />
            <AppBarButton Icon="Add" x:Uid="Toolbar_AddFeed" Label="Add Feed" Click="AddFeed_Click" ToolTipService.ToolTip="Add a feed (Ctrl+N)" />
            <AppBarButton Icon="NewFolder" x:Uid="Toolbar_NewFolder" Label="New Folder" Click="NewFolder_Click" ToolTipService.ToolTip="New folder (Ctrl+Shift+N)" />
            <AppBarSeparator />
            <AppBarButton x:Uid="Toolbar_MarkAllAsRead" Label="Mark All as Read" Click="MarkAllAsRead_Click" ToolTipService.ToolTip="Mark all as read (K)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8FB;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="Toolbar_Read" Label="Read" Click="ToggleRead_Click" ToolTipService.ToolTip="Mark read or unread (R)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE73E;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="Toolbar_Star" Label="Star" Click="ToggleStarred_Click" ToolTipService.ToolTip="Star or unstar (S)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE734;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="Toolbar_NextUnread" Label="Next Unread" Click="NextUnread_Click" ToolTipService.ToolTip="Go to the next unread article (N)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE893;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Uid="Toolbar_OpenInBrowser" Label="Open in Browser" Click="OpenInBrowser_Click" ToolTipService.ToolTip="Open in browser (B)">
                <AppBarButton.Icon><FontIcon Glyph="&#xE774;" /></AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarButton x:Name="SortButton" x:Uid="Toolbar_Sort" Label="Sort" ToolTipService.ToolTip="Sort the timeline">
                <AppBarButton.Icon><FontIcon Glyph="&#xE8CB;" /></AppBarButton.Icon>
                <AppBarButton.Flyout>
                    <MenuFlyout x:Name="SortMenu" Opening="SortMenu_Opening" Placement="BottomEdgeAlignedLeft" />
                </AppBarButton.Flyout>
            </AppBarButton>
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Setting" x:Uid="Toolbar_Settings" Label="Settings…" Click="Settings_Click" ToolTipService.ToolTip="Settings (Ctrl+,)" />
                <AppBarButton Icon="Contact" x:Uid="Toolbar_Accounts" Label="Accounts…" Click="Accounts_Click" />
                <AppBarSeparator />
                <AppBarButton x:Uid="Toolbar_Import" Label="Import Subscriptions…" Click="ImportOpml_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xE8B5;" /></AppBarButton.Icon>
                </AppBarButton>
                <AppBarButton x:Uid="Toolbar_Export" Label="Export Subscriptions…" Click="ExportOpml_Click">
                    <AppBarButton.Icon><FontIcon Glyph="&#xEDE1;" /></AppBarButton.Icon>
                </AppBarButton>
            </CommandBar.SecondaryCommands>
        </CommandBar>

        <Grid Grid.Row="2" Padding="8,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260" MinWidth="180" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="380" MinWidth="240" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <TreeView x:Name="SidebarTree" ItemsSource="{x:Bind Sidebar.Nodes}" SelectionMode="Single"
                      SelectionChanged="SidebarTree_SelectionChanged" CanDragItems="True" AllowDrop="True" CanReorderItems="True"
                      DragItemsStarting="SidebarTree_DragItemsStarting" DragItemsCompleted="SidebarTree_DragItemsCompleted"
                      AutomationProperties.Name="Sidebar">
                <TreeView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SidebarNode">
                        <TreeViewItem ItemsSource="{x:Bind Children}" IsExpanded="{x:Bind IsExpanded, Mode=TwoWay}"
                                      AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                                      ContextRequested="SidebarItem_ContextRequested">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          Visibility="{x:Bind ShowsGlyph, Mode=OneWay}" />
                                <Grid Visibility="{x:Bind HasIcon, Mode=OneWay}">
                                    <Border CornerRadius="3" Margin="-2" Background="{ThemeResource IconBackplateBrush}" Visibility="{x:Bind ShowsIconBackplate, Mode=OneWay}" />
                                    <Image Source="{x:Bind Icon, Mode=OneWay}" Width="16" Height="16" />
                                </Grid>
                                <TextBlock Grid.Column="1" Text="{x:Bind Name, Mode=OneWay}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{x:Bind UnreadText, Mode=OneWay}" VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </Grid>
                        </TreeViewItem>
                    </DataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <toolkit:GridSplitter Grid.Column="1" Width="8" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto" Background="Transparent" />

            <ListView x:Name="TimelineList" Grid.Column="2" ItemsSource="{x:Bind Timeline.Items}" SelectionMode="Extended"
                      SelectionChanged="TimelineList_SelectionChanged" ContainerContentChanging="TimelineList_ContainerContentChanging"
                      x:Uid="TimelineList" AutomationProperties.Name="Timeline">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="vm:TimelineItem">
                        <Grid Padding="0,8" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- Small thumbnails: to the right of the text. -->
                            <Border Grid.Column="2" Width="72" Height="72" CornerRadius="6" VerticalAlignment="Top" Margin="10,2,0,0"
                                    Background="{ThemeResource ControlAltFillColorTertiaryBrush}"
                                    Visibility="{x:Bind ShowsSmallThumbnail, Mode=OneWay}">
                                <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="UniformToFill" />
                            </Border>
                            <StackPanel Spacing="6" Padding="0,6,0,0">
                                <Ellipse Width="8" Height="8" Fill="{ThemeResource AccentFillColorDefaultBrush}" Visibility="{x:Bind IsUnread, Mode=OneWay}" />
                                <FontIcon Glyph="&#xE735;" FontSize="10" Foreground="{ThemeResource SystemFillColorCautionBrush}" Visibility="{x:Bind IsStarred, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="2" Margin="10,0,0,0">
                                <TextBlock Text="{x:Bind Title}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" />
                                <TextBlock Text="{x:Bind Preview}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <Grid ColumnSpacing="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Border CornerRadius="3" Margin="-2" Background="{ThemeResource IconBackplateBrush}" Visibility="{x:Bind ShowsIconBackplate, Mode=OneWay}" />
                                        <Image Source="{x:Bind Icon, Mode=OneWay}" Width="14" Height="14" />
                                    </Grid>
                                    <TextBlock Grid.Column="1" Text="{x:Bind FeedName}" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" Margin="0,0,72,0" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind DateText}" HorizontalAlignment="Right" Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                </Grid>
                                <!-- Large thumbnails: below the text, aspect-fit into a box 180 tall. -->
                                <Border CornerRadius="6" Margin="0,6,0,0" MaxHeight="180" HorizontalAlignment="Left"
                                        Visibility="{x:Bind ShowsLargeThumbnail, Mode=OneWay}">
                                    <Image Source="{x:Bind Thumbnail, Mode=OneWay}" Stretch="Uniform" MaxHeight="180" />
                                </Border>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <toolkit:GridSplitter Grid.Column="3" Width="8" ResizeBehavior="BasedOnAlignment" ResizeDirection="Auto" Background="Transparent" />

            <Grid Grid.Column="4" CornerRadius="8" BorderThickness="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <WebView2 x:Name="ArticleView" x:Uid="ArticleView" AutomationProperties.Name="Article" />
                <Border x:Name="LinkOverlay" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="8"
                        Padding="8,4" CornerRadius="4" Background="{ThemeResource AcrylicInAppFillColorDefaultBrush}">
                    <TextBlock x:Name="LinkOverlayText" Style="{StaticResource CaptionTextBlockStyle}" TextTrimming="CharacterEllipsis" MaxWidth="600" />
                </Border>
            </Grid>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="16,4,16,8" Style="{StaticResource CaptionTextBlockStyle}"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" IsTextSelectionEnabled="True" />
    </Grid>
</Window>
