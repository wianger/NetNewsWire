<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>NetNewsWire.Windows</RootNamespace>
    <AssemblyName>NetNewsWire</AssemblyName>
    <Platforms>x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- The Windows counterpart of main_mac.js; main.js and newsfoot.js come from the core. -->
    <EmbeddedResource Include="Scripts\main_windows.js" LogicalName="main_windows.js" />
  </ItemGroup>

  <!-- The article themes that ship with the app (the repository's Themes folder), next to the exe. -->
  <ItemGroup>
    <None Include="..\..\Themes\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>Themes\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </None>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.7.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>

  <!--
    The Swift core, built by Windows/Core (swift build -c release): NetNewsWireCore.dll, the module
    DLLs it links (RSCore.dll, Account.dll, …), and their resource bundles. build.ps1 passes the
    folder as NetNewsWireCoreDir. The Swift runtime itself comes from the Swift redistributable.
  -->
  <PropertyGroup>
    <NetNewsWireCoreDir Condition="'$(NetNewsWireCoreDir)' == ''">$(MSBuildThisFileDirectory)..\Core\.build\release\</NetNewsWireCoreDir>
  </PropertyGroup>
  <ItemGroup>
    <None Include="$(NetNewsWireCoreDir)*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>%(Filename)%(Extension)</Link>
    </None>
    <None Include="$(NetNewsWireCoreDir)*.resources\**\*;$(NetNewsWireCoreDir)*.bundle\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>$([MSBuild]::MakeRelative($(NetNewsWireCoreDir), %(FullPath)))</Link>
    </None>
  </ItemGroup>

</Project>
